{
  "name": "corex-ui",
  "private": true,
  "description": "A modern, accessible UI component system built with TypeScript and Zag.js. Framework-agnostic, unstyled by default, and flexible for building web interfaces.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm run test:e2e",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.13.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^18.19.130",
    "axe-core": "^4.14.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.1",
    "turbo": "^2.11.13",
    "typescript-eslint": "^8.74.0"
  },
  "pnpm": {
    "overrides": {
      "expr-eval-fork": "3.0.3",
      "esbuild": "0.28.2",
      "glob": "14.0.6",
      "minimatch": "11.0.9",
      "mout": "1.2.4",
      "serialize-javascript": "7.1.4",
      "source-map": "0.7.6",
      "magic-string": "0.30.21",
      "sourcemap-codec": "@jridgewell/sourcemap-codec@^1.5.5"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
